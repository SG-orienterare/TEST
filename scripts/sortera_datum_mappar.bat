@echo off
setlocal

set "MAPP=%~dp0"
set "MAPP=%MAPP:~0,-1%"
set "PS1=%~dp0Reorganize-VideoFolders.ps1"

echo.
echo === Sortera datum-mappar v1.3 ===
echo Skapar/uppdaterar skript...
echo.

powershell -NoProfile -ExecutionPolicy Bypass -Command "[IO.File]::WriteAllBytes('%PS1%', [Convert]::FromBase64String(''))"

if /I "%~1"=="KOR" goto run
if /I "%~1"=="RUN" goto run

echo === TORRKORNING (inget flyttas) ===
echo Mapp: %MAPP%
echo.
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%" -SourcePath "%MAPP%" -DryRun
echo.
echo Om allt ser bra ut, kor:
echo   %~nx0 KOR
echo.
pause
exit /b 0

:run
echo === KOR PA RIKTIGT ===
echo Mapp: %MAPP%
echo.
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%" -SourcePath "%MAPP%"
echo.
pause
exit /b 0
